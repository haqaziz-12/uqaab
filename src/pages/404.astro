---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { getSiteSettings } from '../lib/data';

const settings = await getSiteSettings();
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://uqaabcarpet.com';
const seo = {
  title: 'Page Not Found | UQAAB CARPET',
  description: 'The page you are looking for could not be found.',
  canonical: `${siteUrl}/404`,
  ogType: 'website',
};
---

<BaseLayout seo={seo} settings={settings}>
  <section class="section not-found">
    <div class="container text-center">
      <h1 class="not-found__code">404</h1>
      <h2 class="not-found__title">Page Not Found</h2>
      <p class="not-found__message">
        The page you are looking for may have been moved or no longer exists.
      </p>
      <div class="not-found__actions">
        <a href="/" class="btn btn-primary"><Icon name="home" size={18} /> Back to Home</a>
        <a href="/products" class="btn btn-secondary">Browse Products <Icon name="arrow-right" size={18} /></a>
        <a href="/contact" class="btn btn-ghost">Contact Us</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found { padding: var(--space-32) 0; }
  .not-found__code { font-size: clamp(4rem, 15vw, 8rem); color: var(--color-burgundy); line-height: 1; margin-bottom: var(--space-4); }
  .not-found__title { font-size: var(--text-2xl); margin-bottom: var(--space-4); }
  .not-found__message { color: var(--color-charcoal-soft); margin-bottom: var(--space-8); max-width: 500px; margin-left: auto; margin-right: auto; }
  .not-found__actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-3); }
</style>
