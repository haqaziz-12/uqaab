---
import Icon from '../ui/Icon.astro';

export interface Props { settings?: any; isAdmin?: boolean; }
const { settings, isAdmin = false } = Astro.props;

const navLinks = [
  { label: 'Home', href: '/' }, { label: 'About Us', href: '/about' },
  { label: 'Products', href: '/products' }, { label: 'Our Craft', href: '/craft' },
  { label: 'Services', href: '/services' }, { label: 'Wholesale', href: '/wholesale-exports' },
  { label: 'FAQ', href: '/faq' }, { label: 'Contact', href: '/contact' },
];

const logoUrl = settings?.logo_url || 'https://acmeg.org.af/wp-content/uploads/2024/12/newlogo-1-400x212.png';
const whatsappLink = settings?.whatsapp_link || 'https://wa.me/93771444555';
const email = settings?.email || 'uqaab.carpet@yahoo.com';
const facebookUrl = settings?.facebook_url || 'https://www.facebook.com/share/1ZU2fMvYiZ/';
---

<header class="header" id="site-header">
  <div class="container header__inner">
    <a href="/" class="header__logo" aria-label="UQAAB CARPET — Home">
      <img src={logoUrl} alt="UQAAB CARPET logo" width="160" height="85" loading="eager" class="header__logo-img" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';" />
      <span class="header__logo-fallback" style="display:none;">
        <span class="header__logo-text">UQAAB</span>
        <span class="header__logo-sub">CARPET</span>
      </span>
    </a>

    <nav class="header__nav" aria-label="Primary navigation">
      <ul class="header__nav-list">
        {navLinks.map((link) => (<li><a href={link.href} class="header__nav-link">{link.label}</a></li>))}
      </ul>
    </nav>

    <div class="header__actions">
      <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="header__icon-link" aria-label="Contact us on WhatsApp"><Icon name="message-circle" size={20} /></a>
      <a href={`mailto:${email}`} class="header__icon-link" aria-label="Email us"><Icon name="mail" size={20} /></a>
      <a href={facebookUrl} target="_blank" rel="noopener noreferrer" class="header__icon-link" aria-label="Visit our Facebook page"><Icon name="facebook" size={20} /></a>
      <a href="/inquiry" class="btn btn-primary header__cta">Request a Quote</a>
    </div>

    <button class="header__toggle" id="menu-toggle" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="header__toggle-bar"></span><span class="header__toggle-bar"></span><span class="header__toggle-bar"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobile navigation">
      <ul class="mobile-menu__list">
        {navLinks.map((link) => (<li><a href={link.href} class="mobile-menu__link">{link.label}</a></li>))}
        <li><a href="/inquiry" class="btn btn-primary mobile-menu__cta">Request a Quote</a></li>
      </ul>
      <div class="mobile-menu__social">
        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" aria-label="WhatsApp"><Icon name="message-circle" size={22} /></a>
        <a href={`mailto:${email}`} aria-label="Email"><Icon name="mail" size={22} /></a>
        <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook"><Icon name="facebook" size={22} /></a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const closeMenu = () => { toggle.setAttribute('aria-expanded','false'); toggle.setAttribute('aria-label','Open menu'); menu.hidden = true; document.body.style.overflow = ''; };
    const openMenu = () => { toggle.setAttribute('aria-expanded','true'); toggle.setAttribute('aria-label','Close menu'); menu.hidden = false; document.body.style.overflow = 'hidden'; const f = menu.querySelector('a'); if (f) f.focus(); };
    toggle.addEventListener('click', () => { if (toggle.getAttribute('aria-expanded') === 'true') closeMenu(); else openMenu(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { closeMenu(); toggle.focus(); } });
    menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  }
</script>

<style>
  .header { position: sticky; top: 0; z-index: 100; background-color: var(--color-ivory); border-bottom: 1px solid var(--color-border); }
  .header__inner { display: flex; align-items: center; justify-content: space-between; min-height: var(--header-height); gap: var(--space-4); }
  .header__logo { flex-shrink: 0; display: flex; align-items: center; }
  .header__logo-img { height: 48px; width: auto; }
  .header__logo-fallback { display: none; flex-direction: column; line-height: 1; font-family: var(--font-heading); }
  .header__logo-text { font-size: 1.5rem; font-weight: 700; color: var(--color-burgundy); letter-spacing: 0.05em; }
  .header__logo-sub { font-size: 0.7rem; font-weight: 500; color: var(--color-gold); letter-spacing: 0.3em; text-transform: uppercase; }
  .header__nav { display: none; }
  .header__nav-list { display: flex; list-style: none; gap: var(--space-6); padding: 0; margin: 0; }
  .header__nav-link { font-size: var(--text-sm); font-weight: 500; color: var(--color-charcoal); padding: var(--space-2) 0; border-bottom: 2px solid transparent; transition: color var(--transition-fast), border-color var(--transition-fast); }
  .header__nav-link:hover { color: var(--color-burgundy); border-color: var(--color-gold); }
  .header__actions { display: none; align-items: center; gap: var(--space-3); }
  .header__icon-link { display: flex; align-items: center; justify-content: center; width: 40px; height: 40px; color: var(--color-charcoal-soft); border-radius: 9999px; transition: color var(--transition-fast), background-color var(--transition-fast); }
  .header__icon-link:hover { color: var(--color-burgundy); background-color: var(--color-ivory-warm); }
  .header__cta { padding: 10px 20px; font-size: var(--text-sm); }
  .header__toggle { display: flex; flex-direction: column; justify-content: space-around; width: 44px; height: 44px; background: none; border: none; cursor: pointer; padding: 10px; }
  .header__toggle-bar { display: block; height: 2px; width: 100%; background-color: var(--color-charcoal); border-radius: 2px; transition: all var(--transition-base); }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(2) { opacity: 0; }
  .header__toggle[aria-expanded="true"] .header__toggle-bar:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  .mobile-menu { position: fixed; top: var(--header-height); left: 0; right: 0; bottom: 0; background-color: var(--color-ivory); z-index: 200; overflow-y: auto; padding: var(--space-8) var(--container-padding); }
  .mobile-menu__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: var(--space-4); }
  .mobile-menu__link { font-family: var(--font-heading); font-size: var(--text-xl); font-weight: 500; color: var(--color-charcoal); display: block; padding: var(--space-2) 0; }
  .mobile-menu__cta { margin-top: var(--space-4); width: fit-content; }
  .mobile-menu__social { display: flex; gap: var(--space-6); margin-top: var(--space-8); padding-top: var(--space-6); border-top: 1px solid var(--color-border); }
  .mobile-menu__social a { color: var(--color-charcoal-soft); }
  @media (min-width: 1024px) {
    .header__nav { display: block; } .header__actions { display: flex; }
    .header__toggle { display: none; } .mobile-menu { display: none; }
  }
</style>
