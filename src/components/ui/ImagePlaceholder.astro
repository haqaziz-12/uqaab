---
export interface Props {
  src?: string | null;
  alt?: string;
  aspectRatio?: string;
  color?: 'ivory' | 'beige' | 'burgundy' | 'charcoal' | 'gold';
  label?: string;
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  src, alt = '', aspectRatio = '4/3', color = 'ivory', label,
  loading = 'lazy', class: className = '',
} = Astro.props;

const hasImage = src && src.length > 0;
---

<div class={`image-slot ${className}`} style={`aspect-ratio: ${aspectRatio};`}>
  {hasImage ? (
    <img src={src} alt={alt} loading={loading} decoding="async" class="image-slot__img" />
  ) : (
    <div class={`image-placeholder image-placeholder--${color}`}>
      {label && <span class="image-placeholder__label">{label}</span>}
    </div>
  )}
</div>

<style>
  .image-slot { width: 100%; overflow: hidden; border-radius: var(--radius-md); background-color: var(--placeholder-ivory); }
  .image-slot__img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
