---
import type { Product } from '../../types';
import ImagePlaceholder from '../ui/ImagePlaceholder.astro';
import Icon from '../ui/Icon.astro';

export interface Props { product: Product; }
const { product } = Astro.props;
---

<a href={`/products/${product.slug}`} class="product-card card">
  <div class="product-card__image">
    <ImagePlaceholder src={product.image_front} alt={product.image_front_alt || product.name} aspectRatio="4/3" color="beige" label="Product Image" />
  </div>
  <div class="product-card__body">
    {product.collection_type && <span class="product-card__collection">{product.collection_type}</span>}
    <h3 class="product-card__name">{product.name}</h3>
    {product.category && <span class="product-card__category">{product.category}</span>}
    <div class="product-card__footer">
      <span class="product-card__price">{product.price_display}</span>
      <span class="product-card__link">View Details <Icon name="arrow-right" size={16} /></span>
    </div>
  </div>
</a>

<style>
  .product-card { display: flex; flex-direction: column; text-decoration: none; color: inherit; }
  .product-card:hover { color: inherit; }
  .product-card__image { aspect-ratio: 4/3; overflow: hidden; }
  .product-card__body { padding: var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); flex: 1; }
  .product-card__collection { font-size: var(--text-xs); color: var(--color-gold); text-transform: uppercase; letter-spacing: 0.1em; font-weight: 500; }
  .product-card__name { font-family: var(--font-heading); font-size: var(--text-lg); font-weight: 600; color: var(--color-charcoal); margin: 0; }
  .product-card__category { font-size: var(--text-sm); color: var(--color-charcoal-soft); }
  .product-card__footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; padding-top: var(--space-3); border-top: 1px solid var(--color-border); }
  .product-card__price { font-size: var(--text-sm); color: var(--color-burgundy); font-weight: 500; }
  .product-card__link { display: flex; align-items: center; gap: 4px; font-size: var(--text-sm); color: var(--color-gold); font-weight: 500; }
  .product-card:hover .product-card__link { color: var(--color-burgundy); }
</style>
