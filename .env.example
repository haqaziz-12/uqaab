# UQAAB CARPET — Environment Variables
# Copy this file to ".env" for local development.
# In production, set these in the Cloudflare dashboard under
# Workers & Pages → uqaab-carpet → Settings → Variables & Secrets.
#
# NEVER commit the real .env file or put SUPABASE_SERVICE_ROLE_KEY in frontend code.

# --- Public (safe for browser-side code) ---
PUBLIC_SITE_URL=https://uqaabcarpet.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- Server-only secrets (NEVER expose in frontend) ---
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Optional ---
FORMSPREE_ENDPOINT=
